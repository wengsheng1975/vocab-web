# ===== EnglishReader 服务端环境变量 =====

# 运行环境：development | production
NODE_ENV=development

# 服务端口
PORT=3000

# JWT 密钥（生产环境必填，建议 64+ 字符随机字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# CORS 允许的来源（逗号分隔，生产环境务必配置）
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:5173,http://127.0.0.1:5173

# 爬虫抓取：开发环境证书兜底（仅调试用，生产环境务必保持 false）
# CRAWLER_INSECURE_TLS=false

# 出站请求标识（翻译/语法检查/爬虫可共用）
# OUTBOUND_USER_AGENT=EnglishReader/1.0

# 翻译接口配置（默认 Google 翻译开放接口）
# TRANSLATE_API_BASE=https://translate.googleapis.com
# TRANSLATE_API_PATH=/translate_a/single
# TRANSLATE_TARGET_LANG=zh-CN
# TRANSLATE_TIMEOUT_MS=10000

# 语法检查接口配置（默认 LanguageTool 公共接口）
# LANGUAGETOOL_API_URL=https://api.languagetool.org/v2/check
# LANGUAGETOOL_LANGUAGE=en-US
# GRAMMAR_CHECK_TIMEOUT_MS=8000

# 爬虫抓取请求参数
# CRAWLER_USER_AGENT=EnglishReaderCrawler/1.0
# CRAWLER_FETCH_TIMEOUT_MS=12000
# CRAWLER_FEED_CHINADAILY=https://www.chinadaily.com.cn/rss/china_rss.xml
# CRAWLER_FEED_CHINADAILY_WORLD=https://www.chinadaily.com.cn/rss/world_rss.xml
# CRAWLER_FEED_BBC_WORLD=https://feeds.bbci.co.uk/news/world/rss.xml
# CRAWLER_FEED_NPR_WORLD=https://feeds.npr.org/1004/rss.xml
# CRAWLER_FEED_ALJAZEERA_ALL=https://www.aljazeera.com/xml/rss/all.xml

# 独立模式（跳过登录，单机使用）
# STANDALONE=true

# 数据库存储目录（默认 server/data/）
# DATA_DIR=/path/to/data
